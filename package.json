{
  "name": "gorgias",
  "version": "0.1.0",
  "description": "Rhetorical Device Analyzer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js test/e2e"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "metaphone": "^2.0.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "puppeteer": "^24.36.0",
    "vite": "^5.4.21"
  },
  "author": "",
  "license": "MIT"
}
